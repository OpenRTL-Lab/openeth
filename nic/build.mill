package build
import mill._
import mill.scalalib._

object core extends SbtModule {
  def scalaVersion = "2.13.12"
  override def scalacOptions = Seq("-language:reflectiveCalls", "-deprecation", "-feature")
  override def mvnDeps = Seq(mvn"org.chipsalliance::chisel:6.5.0")
  override def scalacPluginMvnDeps = Seq(mvn"org.chipsalliance:::chisel-plugin:6.5.0")
  object test extends SbtTests with TestModule.ScalaTest {
    override def mvnDeps = Seq(mvn"edu.berkeley.cs::chiseltest:6.0.0", mvn"org.scalatest::scalatest:3.2.19")
  }
}
